      "item": [
        {
          "name": "Login OK 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('token', cuerpo.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "RF-13. Credencial correcta: HTTP 200 y JWT con sub, nombre y rol."
